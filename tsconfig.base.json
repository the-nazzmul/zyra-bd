{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@zyra-bd/source"],
    "paths": {
      "@zyra-bd/error-handler": ["packages/error-handler/index.ts"],
      "@zyra-bd/prisma": ["packages/libs/prisma/index.ts"],
      "@zyra-bd/redis": ["packages/libs/redis/index.ts"]
    }
  }
}
